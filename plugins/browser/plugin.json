{
  "schema": "synergy.plugin.v1",
  "id": "browser.local.playwright",
  "name": "OPEN AUTOPILOT Browser Bridge",
  "version": "1.0.0",
  "kind": "browser",
  "provider": "crates/autopilot-computer-use + tools/browser/bridge.mjs",
  "capabilities": [
    {"name":"browser.navigate","risk":"Medium","requires_approval":false,"mapped_core_capabilities":["NetworkAccess","ComputerUse"]},
    {"name":"browser.snapshot","risk":"Low","requires_approval":false,"mapped_core_capabilities":["ComputerUse"]},
    {"name":"browser.click","risk":"High","requires_approval":true,"mapped_core_capabilities":["ComputerUse"]},
    {"name":"browser.fill","risk":"High","requires_approval":true,"mapped_core_capabilities":["ComputerUse"]},
    {"name":"browser.wait","risk":"Low","requires_approval":false,"mapped_core_capabilities":["ComputerUse"]},
    {"name":"browser.screenshot","risk":"Low","requires_approval":false,"mapped_core_capabilities":["ComputerUse"]}
  ],
  "endpoints": [{"transport":"native_node","address":"tools/browser/bridge.mjs"}],
  "tags": ["browser","playwright","computer-use","web"],
  "requires": [],
  "enabled_by_default": false
}
