{
  "schema": "synergy.plugin.v1",
  "id": "workers.agent.fabric",
  "name": "SYNERGY Agent Fabric",
  "version": "1.0.0",
  "kind": "worker",
  "provider": "Shtenco/synergy_ai_blockchain#feat/p7-node-commander-agent-fabric",
  "capabilities": [
    {
      "name": "worker.register",
      "risk": "Medium",
      "requires_approval": false,
      "mapped_core_capabilities": [],
      "parallel_safe": false
    },
    {
      "name": "worker.schedule",
      "risk": "Medium",
      "requires_approval": false,
      "mapped_core_capabilities": [],
      "parallel_safe": false
    },
    {
      "name": "worker.lease",
      "risk": "Medium",
      "requires_approval": false,
      "mapped_core_capabilities": [],
      "parallel_safe": false
    },
    {
      "name": "worker.remote.delegate",
      "risk": "High",
      "requires_approval": true,
      "mapped_core_capabilities": [
        "NetworkAccess"
      ],
      "parallel_safe": false
    }
  ],
  "endpoints": [
    {
      "transport": "rust_adapter",
      "address": "node-runtime/crates/agent-fabric"
    }
  ],
  "tags": [
    "workers",
    "swarm",
    "scheduler",
    "distributed"
  ],
  "requires": [],
  "enabled_by_default": false,
  "input_contracts": {
    "worker.schedule": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "default": []
        },
        "task": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "task"
      ],
      "additionalProperties": false
    },
    "worker.lease": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "default": []
        },
        "task": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "task"
      ],
      "additionalProperties": false
    },
    "worker.register": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "department_id": {
          "type": "string"
        },
        "supervisor_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_millis": {
          "type": "integer",
          "minimum": 0,
          "default": 1000
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 0,
          "default": 1024
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "remote": {
          "type": "boolean",
          "default": false
        },
        "workspace": {
          "type": "string"
        },
        "memory_namespace": {
          "type": "string"
        },
        "model_policy": {
          "type": "string"
        },
        "device_policy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": true
    }
  },
  "output_contracts": {
    "worker.schedule": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "epoch": {
          "type": "integer"
        },
        "expires_epoch": {
          "type": "integer"
        },
        "lease_root": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": [
        "task_id",
        "agent_id",
        "epoch",
        "expires_epoch",
        "lease_root"
      ],
      "additionalProperties": false
    },
    "worker.lease": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "epoch": {
          "type": "integer"
        },
        "expires_epoch": {
          "type": "integer"
        },
        "lease_root": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": [
        "task_id",
        "agent_id",
        "epoch",
        "expires_epoch",
        "lease_root"
      ],
      "additionalProperties": false
    },
    "worker.register": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "registered": {
          "type": "boolean"
        }
      },
      "required": [
        "agent_id",
        "registered"
      ],
      "additionalProperties": true
    }
  }
}
