{
  "schema": "synergy.plugin.v1",
  "id": "business.auto-company",
  "name": "SYNERGY Auto-Company 2.0",
  "version": "2.0.0-alpha1",
  "kind": "business",
  "provider": "Shtenco/synergy_ai_company#feat/auto-company-v2",
  "capabilities": [
    {
      "name": "company.status",
      "risk": "Low",
      "requires_approval": false,
      "mapped_core_capabilities": [],
      "parallel_safe": true
    },
    {
      "name": "company.opportunity.ingest",
      "risk": "Low",
      "requires_approval": false,
      "mapped_core_capabilities": [
        "NetworkAccess"
      ],
      "parallel_safe": false
    },
    {
      "name": "company.action.approve",
      "risk": "High",
      "requires_approval": true,
      "mapped_core_capabilities": [],
      "parallel_safe": false
    },
    {
      "name": "company.action.dispatch",
      "risk": "High",
      "requires_approval": true,
      "mapped_core_capabilities": [
        "NetworkAccess"
      ],
      "parallel_safe": false
    },
    {
      "name": "company.pause",
      "risk": "High",
      "requires_approval": true,
      "mapped_core_capabilities": [],
      "parallel_safe": false
    }
  ],
  "endpoints": [
    {
      "transport": "http",
      "address": "auto-company-v2 FastAPI /v1"
    }
  ],
  "tags": [
    "business",
    "revenue",
    "risk",
    "opportunities",
    "company"
  ],
  "requires": [
    "business.capability.runtime"
  ],
  "enabled_by_default": false,
  "input_contracts": {
    "company.status": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "company.opportunity.ingest": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "url": {
          "type": "string",
          "default": ""
        },
        "expected_revenue_usd": {
          "type": "number",
          "default": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "default": 0
        },
        "probability": {
          "type": "number",
          "default": 0
        },
        "hours": {
          "type": "number",
          "default": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "title",
        "source"
      ],
      "additionalProperties": false
    },
    "company.action.approve": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action_id"
      ],
      "additionalProperties": false
    },
    "company.action.dispatch": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action_id"
      ],
      "additionalProperties": false
    },
    "company.pause": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "output_contracts": {
    "company.status": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "paused": {
          "type": "boolean"
        },
        "autopilot_runtime_enabled": {
          "type": "boolean"
        },
        "nexus_runtime_enabled": {
          "type": "boolean"
        },
        "operational_revenue_evidence_usd": {
          "type": "number"
        },
        "operational_cost_usd": {
          "type": "number"
        },
        "operational_margin_usd": {
          "type": "number"
        },
        "financial_authority": {
          "type": "string"
        },
        "ai_spend_today_usd": {
          "type": "number"
        },
        "ai_daily_budget_usd": {
          "type": "number"
        },
        "registry": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "mode",
        "paused",
        "autopilot_runtime_enabled",
        "nexus_runtime_enabled",
        "operational_revenue_evidence_usd",
        "operational_cost_usd",
        "operational_margin_usd",
        "financial_authority",
        "ai_spend_today_usd",
        "ai_daily_budget_usd",
        "registry"
      ],
      "additionalProperties": true
    },
    "company.opportunity.ingest": {
      "type": "object",
      "properties": {
        "opportunity": {
          "type": "object",
          "additionalProperties": true
        },
        "score": {
          "type": "number"
        },
        "validation_action": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "opportunity",
        "score",
        "validation_action"
      ],
      "additionalProperties": false
    },
    "company.action.approve": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "action_id": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "const": "approved"
        }
      },
      "required": [
        "ok",
        "action_id",
        "state"
      ],
      "additionalProperties": false
    },
    "company.action.dispatch": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "result": {}
      },
      "required": [
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    "company.pause": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "paused": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "ok",
        "paused"
      ],
      "additionalProperties": false
    }
  }
}
