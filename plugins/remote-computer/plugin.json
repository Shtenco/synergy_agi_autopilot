{
  "schema": "synergy.plugin.v1",
  "id": "computer.remote.shttps",
  "name": "SYNERGY Remote MCP",
  "version": "1.0.0",
  "kind": "remote_mcp",
  "provider": "Shtenco/synergy_shttps",
  "capabilities": [
    {
      "name": "computer.remote.list_dir",
      "risk": "Low",
      "requires_approval": false,
      "mapped_core_capabilities": [
        "NetworkAccess",
        "ReadWorkspace"
      ]
    },
    {
      "name": "computer.remote.read_file",
      "risk": "Low",
      "requires_approval": false,
      "mapped_core_capabilities": [
        "NetworkAccess",
        "ReadWorkspace"
      ]
    },
    {
      "name": "computer.remote.run",
      "risk": "High",
      "requires_approval": true,
      "mapped_core_capabilities": [
        "NetworkAccess",
        "ExecuteProcess"
      ]
    }
  ],
  "endpoints": [
    {
      "transport": "mcp_stdio",
      "address": "synergy-mcp-gateway"
    },
    {
      "transport": "shttps_stcp",
      "address": "synergy.remote.mcp.v1"
    }
  ],
  "tags": [
    "computer",
    "remote",
    "mcp",
    "shttps",
    "stcp"
  ],
  "requires": [],
  "enabled_by_default": false,
  "input_contracts": {
    "computer.remote.list_dir": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "default": "."
        }
      },
      "additionalProperties": false
    },
    "computer.remote.read_file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "computer.remote.run": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "cwd": {
          "type": "string",
          "default": "."
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    }
  },
  "output_contracts": {
    "computer.remote.list_dir": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "file",
                  "dir"
                ]
              },
              "size": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "type",
              "size"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "path",
        "entries"
      ],
      "additionalProperties": true
    },
    "computer.remote.read_file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "size",
        "text"
      ],
      "additionalProperties": true
    },
    "computer.remote.run": {
      "type": "object",
      "properties": {
        "returncode": {
          "type": "integer"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "returncode",
        "stdout",
        "stderr",
        "truncated"
      ],
      "additionalProperties": true
    }
  }
}
