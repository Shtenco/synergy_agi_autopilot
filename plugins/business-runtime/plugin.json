    "business.ceo.plan": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "goal"
      ],
      "additionalProperties": false
    },
    "business.cfo.analyze": {
      "type": "object",
      "properties": {
        "revenue_usd": {
          "type": "number",
          "default": 0
        },
        "costs": {
          "type": "object",
          "default": {},
          "additionalProperties": true
        },
        "budget_usd": {
          "type": "number",
          "default": 0
        },
        "ad_spend_usd": {
          "type": "number",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "business.smm.plan": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "default": "продукт"
        },
        "audience": {
          "type": "string",
          "default": "целевая аудитория"
        },
        "objective": {
          "type": "string",
          "default": "лиды"
        },
        "days": {
          "type": "integer",
          "default": 14
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "telegram",
            "vk",
            "instagram"
          ]
        }
      },
      "additionalProperties": false
    },
    "business.sales.plan": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "current_score": {
          "type": "integer",
          "default": 0
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "business.verify.evidence": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "required",
        "evidence"
      ],
      "additionalProperties": false
    },
    "business.external.publish": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "default": {},
          "additionalProperties": true
        }
      },
      "required": [
        "capability"
      ],
      "additionalProperties": false
    },
    "business.sales.compose_offer": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "default": "продукт"
        },
        "value": {
          "type": "string",
          "default": "полезный результат"
        },
        "name": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    }
  },
  "output_contracts": {
    "business.ceo.plan": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "succeeded"
        },
        "result": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string"
            },
            "goal": {
              "type": "string"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "execution_authority": {
              "type": "string"
            }
          },
          "required": [
            "schema",
            "goal",
            "capabilities",
            "execution_authority"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "status",
        "result"
      ],
      "additionalProperties": true
    },
    "business.cfo.analyze": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "succeeded"
        },
        "result": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string"
            },
            "revenue_usd": {
              "type": "number"
            },
            "cost_usd": {
              "type": "number"
            },
            "operating_margin_usd": {
              "type": "number"
            },
            "margin_pct": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
