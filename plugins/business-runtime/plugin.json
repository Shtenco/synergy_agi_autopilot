    {
      "name": "business.ceo.plan",
      "risk": "Low",
      "requires_approval": false,
      "mapped_core_capabilities": [],
      "parallel_safe": true
    },
    {
      "name": "business.cfo.analyze",
      "risk": "Low",
      "requires_approval": false,
      "mapped_core_capabilities": [],
      "parallel_safe": true
    },
    {
      "name": "business.smm.plan",
      "risk": "Low",
      "requires_approval": false,
      "mapped_core_capabilities": [],
      "parallel_safe": true
    },
    {
      "name": "business.sales.plan",
      "risk": "Low",
      "requires_approval": false,
      "mapped_core_capabilities": [],
      "parallel_safe": true
    },
    {
      "name": "business.sales.compose_offer",
      "risk": "Low",
      "requires_approval": false,
      "mapped_core_capabilities": [],
      "parallel_safe": true
    },
    {
      "name": "business.verify.evidence",
      "risk": "Low",
      "requires_approval": false,
      "mapped_core_capabilities": [],
      "parallel_safe": true
    },
    {
      "name": "business.external.publish",
      "risk": "High",
      "requires_approval": true,
      "mapped_core_capabilities": [
        "NetworkAccess"
      ],
      "parallel_safe": false
    }
  ],
  "endpoints": [
    {
      "transport": "http",
      "address": "http://127.0.0.1:8120"
    }
  ],
  "tags": [
    "business",
    "smm",
    "sales",
    "cfo",
    "ceo"
  ],
  "requires": [],
  "enabled_by_default": false,
