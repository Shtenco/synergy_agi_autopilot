            "authority": {
              "type": "string"
            }
          },
          "required": [
            "schema",
            "revenue_usd",
            "cost_usd",
            "operating_margin_usd",
            "authority"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "status",
        "result"
      ],
      "additionalProperties": true
    },
    "business.smm.plan": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "succeeded"
        },
        "result": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "day": {
                    "type": "integer"
                  },
                  "platform": {
                    "type": "string"
                  },
                  "pillar": {
                    "type": "string"
                  },
                  "brief": {
                    "type": "string"
                  },
                  "cta": {
                    "type": "string"
                  }
                },
                "required": [
                  "day",
                  "platform",
                  "pillar",
                  "brief",
                  "cta"
                ],
                "additionalProperties": true
              }
            },
            "external_effects": {
              "type": "boolean"
            }
          },
          "required": [
            "schema",
            "items",
            "external_effects"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "status",
        "result"
      ],
      "additionalProperties": true
    },
    "business.sales.plan": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "succeeded"
        },
        "result": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string"
            },
            "score": {
              "type": "integer"
            },
            "stage": {
              "type": "string"
            },
            "objection": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recommended_next_action": {
              "type": "string"
            }
          },
          "required": [
            "schema",
            "score",
            "stage",
            "recommended_next_action"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "status",
        "result"
      ],
      "additionalProperties": true
    },
    "business.sales.compose_offer": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "succeeded"
        },
        "result": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "delivery_authority": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "schema",
            "kind",
            "message",
            "delivery_authority",
            "note"
          ],
          "additionalProperties": true
