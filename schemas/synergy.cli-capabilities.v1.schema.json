{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.local/schemas/synergy.cli-capabilities.v1.schema.json",
  "title": "SYNERGY Declarative CLI Capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "commands"
  ],
  "properties": {
    "schema": {
      "const": "synergy.cli-capabilities.v1"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program",
          "capability",
          "input_schema"
        ],
        "properties": {
          "program": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ],
            "default": "Medium"
          },
          "requires_approval": {
            "type": "boolean"
          },
          "input_schema": {
            "type": "object"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "output_schema": {
            "type": "object"
          }
        }
      }
    }
  }
}
