{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.local/schemas/synergy.workforce.v1.schema.json",
  "title": "SYNERGY Persistent AI Workforce v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "defaults"
  ],
  "properties": {
    "schema": {
      "const": "synergy.workforce.v1"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_seconds",
        "offline_after_seconds",
        "max_attempts",
        "escalation_after_seconds",
        "min_skill_level"
      ],
      "properties": {
        "lease_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 86400
        },
        "offline_after_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "escalation_after_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 604800
        },
        "min_skill_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "department_cycle_max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "department_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lease_seconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 86400
          },
          "offline_after_seconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 86400
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "escalation_after_seconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 604800
          },
          "min_skill_level": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "department_cycle_max_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      }
    }
  }
}
