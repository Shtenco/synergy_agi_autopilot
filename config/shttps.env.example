# AUTOPILOT production SHTTPS endpoint. Trust is derived from the signed Federation Trust Registry.
AUTOPILOT_SHTTPS_REPOSITORY=agi_autopilot
AUTOPILOT_SHTTPS_IDENTITY=/run/secrets/agi_autopilot.identity.json
AUTOPILOT_SHTTPS_FEDERATION_ROOT=/etc/synergy/federation-root.json
AUTOPILOT_SHTTPS_FEDERATION_REGISTRY=/etc/synergy/federation-registry.signed.json
AUTOPILOT_SHTTPS_FEDERATION_STATE=/var/lib/synergy/autopilot-federation-state.json
AUTOPILOT_SHTTPS_BIND_HOST=127.0.0.1
AUTOPILOT_SHTTPS_BIND_PORT=8120
AUTOPILOT_SHTTPS_REQUIRE_AI_COMPRESS=1
AUTOPILOT_SHTTPS_MAX_IDENTITY=0
SHTTPS_AI_COMPRESS_PATH=/opt/synergy/ai_compress

# Do not set AUTOPILOT_SHTTPS_ALLOW_LEGACY_TRUST in production.
# Auto-Company authorization is read from its signed control-principal ACL in the registry.
